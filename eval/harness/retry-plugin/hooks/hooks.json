{
  "description": "Retry control — blocks every stop with a generic instruction; no check is run",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/retry-stop.mjs"],
            "timeout": 30,
            "statusMessage": "Retry control: requesting another pass"
          }
        ]
      }
    ]
  }
}
