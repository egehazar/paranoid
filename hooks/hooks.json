{
  "description": "Paranoid — the agent cannot finish until the project's real-app check passes",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/paranoid-stop.mjs"],
            "timeout": 300,
            "statusMessage": "Paranoid: running the real-app check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/paranoid-guard.mjs"]
          }
        ]
      }
    ]
  }
}
